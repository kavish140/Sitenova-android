# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: Required for Supabase API calls
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: Required for Supabase API calls
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# EMAILJS_SERVICE_ID: Required for EmailJS API calls
EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID_HERE

# EMAILJS_TEMPLATE_ID: Required for EmailJS API calls
EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID_HERE

# EMAILJS_CUSTOMER_TEMPLATE_ID: Required for EmailJS API calls
EMAILJS_CUSTOMER_TEMPLATE_ID=YOUR_EMAILJS_CUSTOMER_TEMPLATE_ID_HERE

# EMAILJS_USER_ID: Required for EmailJS API calls
EMAILJS_USER_ID=YOUR_EMAILJS_USER_ID_HERE
